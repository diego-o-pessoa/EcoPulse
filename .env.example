# Database
POSTGRES_USER=ecopulse_user
POSTGRES_PASSWORD=ecopulse_pass
POSTGRES_DB=ecopulse_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Message Broker
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@localhost:5672/

# Cache
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET=super_secret_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO (Object Storage)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123

# FCM (Firebase Cloud Messaging) - Opcional
FCM_CONFIG=
