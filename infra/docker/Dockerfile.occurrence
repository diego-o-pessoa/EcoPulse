FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (PostGIS requires libpq-dev, etc.)
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Set python path
ENV PYTHONPATH=/app

CMD ["python", "workers/occurrence/main.py"]
